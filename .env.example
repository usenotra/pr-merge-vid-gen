# GitHub App (required in production)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Slug from https://github.com/apps/<slug>, used for the "Add private repos" link
GITHUB_APP_SLUG=

# Optional local fallback when OAuth is not configured
GITHUB_TOKEN=

# Canonical site URL used for OAuth callbacks in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
